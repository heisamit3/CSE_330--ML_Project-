# MAP Misconception Detection API - Environment Variables

# Model Configuration
# HuggingFace model ID or local path
BASE_MODEL_PATH=Qwen/Qwen3-8B
# Path to LoRA adapter (local path or HF Hub ID)
ADAPTER_PATH=./data/adapter

# Quantization
USE_4BIT_QUANTIZATION=true
TORCH_DTYPE=float16

# Inference
MAX_LEN=256
BATCH_SIZE=1

# Explainer
USE_LLM_EXPLAINER=true
USE_LLM_VERIFIER=false
MAX_NEW_TOKENS=320

# Data Paths
TRAIN_DATA_PATH=./data/train.csv
KB_PATH=./data/misconception_kb.json
LABEL_ENCODER_PATH=./data/label_encoder.pkl
CORRECT_ANSWERS_PATH=./data/correct_answers.json

# Server
HOST=0.0.0.0
PORT=8000

# HuggingFace (required for gated models)
HF_TOKEN=your_huggingface_token_here
